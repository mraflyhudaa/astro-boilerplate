---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromPath } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

const lang = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(lang);
---

<BaseLayout
	title={t('notFound.title')}
	description={t('notFound.description')}
	locale={lang}
	noindex
>
	<section class="mx-auto flex w-full max-w-3xl flex-col items-start px-4 py-24 sm:px-6">
		<p class="text-sm font-medium text-muted">404</p>
		<h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{t('notFound.title')}</h1>
		<p class="mt-3 text-lg text-muted">{t('notFound.description')}</p>
		<a
			href={`/${lang}/`}
			class="mt-8 rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90"
		>
			{t('notFound.home')}
		</a>
	</section>
</BaseLayout>
