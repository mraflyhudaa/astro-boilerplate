---
import BlogCard from '../BlogCard.astro';
import { locales, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts } from '../../lib/posts';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getBlogPosts(lang);
const alternates = locales.map((locale) => ({ locale, href: `/${locale}/blog/` }));
---

<BaseLayout
	title={t('blog.title')}
	description={t('blog.description')}
	locale={lang}
	alternates={alternates}
	image={`/og/${lang}/home.png`}
>
	<section class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
		<header class="max-w-2xl">
			<h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t('blog.title')}</h1>
			<p class="mt-3 text-lg text-muted">{t('blog.description')}</p>
		</header>

		{posts.length === 0 ? (
			<p class="mt-10 text-muted">{t('blog.empty')}</p>
		) : (
			<ul class="mt-10 grid gap-6 sm:grid-cols-2">
				{posts.map((post) => (
					<li>
						<BlogCard entry={post} />
					</li>
				))}
			</ul>
		)}
	</section>
</BaseLayout>
