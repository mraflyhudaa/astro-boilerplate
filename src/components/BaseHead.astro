---
import { Font } from 'astro:assets';

import { defaultLocale, localeTags, ogLocales } from '../i18n/config';
import type { Locale } from '../i18n/config';
import type { AlternateLink } from '../lib/seo';
import { absoluteUrl, canonicalUrl } from '../lib/seo';
import { SITE, resolveSite } from '../lib/site';

interface Props {
	title: string;
	description: string;
	locale: Locale;
	alternates?: readonly AlternateLink[] | undefined;
	image?: string | undefined;
	type?: 'website' | 'article' | undefined;
	noindex?: boolean | undefined;
	publishedTime?: Date | undefined;
	modifiedTime?: Date | undefined;
	tags?: readonly string[] | undefined;
	jsonLd?: readonly Record<string, unknown>[] | undefined;
}

const {
	title,
	description,
	locale,
	alternates = [],
	image = SITE.defaultOgImage,
	type = 'website',
	noindex = false,
	publishedTime,
	modifiedTime,
	tags = [],
	jsonLd = [],
} = Astro.props;

const site = resolveSite(Astro.site);
const canonical = canonicalUrl(Astro.url.pathname, site);
const ogImage = absoluteUrl(image, site);
const rssHref = absoluteUrl(`/${locale}/rss.xml`, site);
const defaultAlternate = alternates.find((alternate) => alternate.locale === defaultLocale);
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Font cssVariable="--font-inter" preload />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonical} />

{noindex ? (
	<meta name="robots" content="noindex, nofollow" />
) : (
	<meta name="robots" content="index, follow, max-image-preview:large" />
)}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE.name} (${localeTags[locale]})`}
	href={rssHref}
/>
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0f14" />

{alternates.map((alternate) => (
	<link
		rel="alternate"
		hreflang={localeTags[alternate.locale]}
		href={absoluteUrl(alternate.href, site)}
	/>
))}
{defaultAlternate && (
	<link rel="alternate" hreflang="x-default" href={absoluteUrl(defaultAlternate.href, site)} />
)}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocales[locale]} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{tags.map((tag) => (
	<meta property="article:tag" content={tag} />
))}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd.map((schema) => (
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
