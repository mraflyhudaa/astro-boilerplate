{
	"name": "astro-boilerplate",
	"type": "module",
	"version": "0.1.0",
	"engines": {
		"node": ">=22.23.4",
		"pnpm": ">=12.15.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"sync": "astro sync",
		"check": "astro check",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "pnpm run test:unit",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/mdx": "^8.1.5",
		"@astrojs/node": "^11.1.12",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^7.4.11",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"astro-eslint-parser": "^3.2.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"satori": "^0.63.2",
		"satori-html": "^0.3.2",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	},
	"private": true,
	"description": "Production-ready Astro boilerplate with typed content collections, i18n routing, SEO, tests, and Docker.",
	"packageManager": "pnpm@12.15.0"
}
